# Optional live model configuration. Mock mode works without these values.
# Any Chat Completions-compatible endpoint can be used here.
AGENTSIM_MODEL_PROVIDER=chat-completions-compatible
AGENTSIM_MODEL_API_KEY=
AGENTSIM_MODEL_BASE_URL=https://api.openai.com/v1
AGENTSIM_MODEL_NAME=gpt-4.1-mini

# Backward-compatible aliases are also supported:
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4.1-mini
# OPENAI_COMPATIBLE_API_KEY=
# OPENAI_COMPATIBLE_BASE_URL=
# OPENAI_COMPATIBLE_MODEL=
