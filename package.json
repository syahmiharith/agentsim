{
  "name": "agentsim",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Artifact-first AI organization layer for solo software freelancers.",
  "bin": {
    "agentsim": "dist/src/cli.js"
  },
  "scripts": {
    "agentsim": "tsx src/cli.ts",
    "demo": "tsx src/cli.ts run",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "eval:mock": "tsx src/evals/run-evals.ts"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "tsx": "^4.20.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.7"
  },
  "engines": {
    "node": ">=20.11"
  },
  "dependencies": {
    "commander": "^12.1.0",
    "zod": "^4.4.3"
  }
}
