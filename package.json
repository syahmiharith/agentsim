{
  "name": "agentsim",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Artifact-first AI organization layer for solo software freelancers.",
  "bin": {
    "agentsim": "dist/src/cli.js"
  },
  "scripts": {
    "agentsim": "tsx src/cli.ts",
    "demo": "tsx src/cli.ts run",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "eval": "tsx src/evals/run-evals.ts --suite all --mode mock",
    "eval:mock": "tsx src/evals/run-evals.ts --suite smoke --mode mock",
    "eval:domain": "tsx src/evals/run-evals.ts --suite domain --mode mock",
    "eval:throughput": "tsx src/evals/run-throughput.ts --suite smoke --mode mock --concurrency 4 --repeat 3"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@vitest/coverage-v8": "^3.2.0",
    "tsx": "^4.20.0",
    "typescript": "^5.8.0",
    "vitest": "^3.2.0"
  },
  "engines": {
    "node": ">=20.11"
  },
  "dependencies": {
    "commander": "^12.1.0",
    "zod": "^4.4.3"
  }
}
