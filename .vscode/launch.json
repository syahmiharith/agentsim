{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug CLI demo (mock)",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "node",
      "runtimeArgs": ["--import", "tsx"],
      "args": [
        "src/cli.ts",
        "run",
        "Build an inventory request system for a flower company",
        "--mock"
      ],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "skipFiles": ["<node_internals>/**"]
    },
    {
      "name": "Debug CLI prompt (mock)",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "node",
      "runtimeArgs": ["--import", "tsx"],
      "args": ["src/cli.ts", "run", "${input:clientGoal}", "--mock"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "skipFiles": ["<node_internals>/**"]
    }
  ],
  "inputs": [
    {
      "id": "clientGoal",
      "type": "promptString",
      "description": "Client goal for Agentsim",
      "default": "Build an inventory request system for a flower company"
    }
  ]
}
