{
  "python.terminal.useEnvFile": true,
  "npm.packageManager": "pnpm",
  "typescript.tsdk": "node_modules/typescript/lib",
  "typescript.enablePromptUseWorkspaceTsdk": true,
  "search.exclude": {
    "**/coverage": true,
    "**/dist": true,
    "**/node_modules": true,
    "**/outputs": true
  },
  "files.watcherExclude": {
    "**/coverage/**": true,
    "**/dist/**": true,
    "**/node_modules/**": true,
    "**/outputs/**": true
  }
}
